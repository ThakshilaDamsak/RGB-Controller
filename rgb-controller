# ═══════════════════════════════ controller ═══════════════════════════════
class Controller:
    def __init__(self, loop):
        self.loop = loop
        self.session = self.system = None
        self.runner = ProfileRunner()
        self.runner.on_change = self.emit_state
        self.sleeping = False      # between PrepareForSleep(true) and (false)
        self.settling = False      # resumed, waiting for USB/OpenRGB to come back
        self.monitoring = False    # False while on battery
        self.target = None
        self.reason = "starting"
        self.last_state = None
        self.cfg_monitor = None
        self.running = set()       # non-gate sources currently started
        self.all = {n: cls(self) for n, cls in SOURCES.items()}
        self.eval_timer = Timer(self.evaluate)
        self.settle_timer = Timer(self._after_resume)
        self.state_timer = Timer(self._emit_state)
        self.cfg_timer = Timer(self.reload)

    @property
    def sources(self):
        """Enabled sources in priority order (ac first, always)."""
        out = {"ac": self.all["ac"]}
        for n in PRIORITY:
            if n in self.all and n not in out:
                out[n] = self.all[n]
        return out

    # --- bus plumbing -----------------------------------------------------
    def connect(self):
        self.session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        try:
            self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error as e:
            log.warning("system bus unavailable (%s): AC detection falls back to sysfs, no suspend handling", e.message)
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        self.session.register_object(OBJ_PATH, node.interfaces[0], self._on_method, None, None)
        ring.sink = self._emit_log

    def start(self):
        if self.system:
            self.system.signal_subscribe(
                "org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE,
                lambda conn, sender, path, iface, sig, params, *_: self.on_sleep(params.unpack()[0]),
            )
        self.all["ac"].start()
        self._watch_config()
        self.schedule()
        log.info("rgb-controller ready")

    def _watch_config(self):
        path = config_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            self.cfg_monitor = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
            self.cfg_monitor.connect("changed", lambda *a: self.cfg_timer.restart(300))
        except (OSError, GLib.Error) as e:
            log.warning("config: cannot watch %s (%s); use the Reload call instead", path, e)

    def _emit_log(self, line):
        if self.session:
            self.session.emit_signal(None, OBJ_PATH, IFACE, "Log", GLib.Variant("(s)", (line,)))

    def _on_method(self, conn, sender, path, iface, method, params, invocation, *_):
        try:
            if method == "Hold":
                source, token, pid = params.unpack()
                self.all[source].hold(token, pid)
                invocation.return_value(None)
            elif method == "Release":
                source, token = params.unpack()
                self.all[source].release(token)
                invocation.return_value(None)
            elif method == "Pin":
                profile, seconds = params.unpack()
                self.all["pin"].pin(profile, seconds)
                invocation.return_value(None)
            elif method == "Unpin":
                self.all["pin"].unpin()
                invocation.return_value(None)
            elif method == "Reevaluate":
                self.runner.invalidate()
                self.schedule(immediate=True)
                invocation.return_value(None)
            elif method == "Reload":
                self.cfg_timer.cancel()
                self.reload()
                invocation.return_value(None)
            elif method == "Status":
                invocation.return_value(GLib.Variant("(s)", (json.dumps(self.status()),)))
            elif method == "Config":
                invocation.return_value(GLib.Variant("(s)", (json.dumps(self.config_dump()),)))
            elif method == "History":
                invocation.return_value(GLib.Variant("(s)", (json.dumps(list(ring.lines)),)))
            else:
                invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
        except (KeyError, ValueError) as e:
            invocation.return_dbus_error("org.freedesktop.DBus.Error.InvalidArgs", f"{method}: {e}")

    def status(self):
        return {
            "target": self.target,
            "applied": self.runner.applied,
            "reason": self.reason,
            "failing": self.runner.gave_up,
            "monitoring": self.monitoring,
            "sleeping": self.sleeping or self.settling,
            "order": list(self.sources),
            "wants": {n: s.wanted() for n, s in self.sources.items()},
            "config": (_config_hash or "")[:8],
            "sources": {n: s.describe() for n, s in self.all.items()},
        }

    def config_dump(self):
        g = globals()
        return {
            "path": config_path(),
            "values": {k.lower(): g[k] for k in _TUNABLES},
            "defaults": {k.lower(): _DEFAULTS[k] for k in _TUNABLES},
            "sources": list(SOURCES),
        }

    def emit_state(self):
        self.state_timer.start(100)

    def _emit_state(self):
        js = json.dumps(self.status(), sort_keys=True)
        if js != self.last_state and self.session:
            self.last_state = js
            self.session.emit_signal(None, OBJ_PATH, IFACE, "StateChanged", GLib.Variant("(s)", (js,)))

    # --- decisions ----------------------------------------------------------
    def schedule(self, immediate=False):
        if immediate:
            self.evaluate()
        else:
            self.eval_timer.start(DEBOUNCE_MS)

    def on_ac_changed(self):
        self.schedule(immediate=True)  # unplugging must switch lights off right now

    def evaluate(self):
        self.eval_timer.cancel()
        if self.sleeping or self.settling:
            self.emit_state()
            return
        srcs = self.sources
        gated = any(s.gate and s.wanted() for s in srcs.values())
        if gated and self.monitoring:
            self._set_monitoring(False)
        elif not gated and not self.monitoring:
            self._set_monitoring(True)
            self.schedule()  # let the resyncs land before choosing a profile
            self.emit_state()
            return
        target, reason = PROFILE_DEFAULT, "fallback"
        for name, s in srcs.items():
            profile = s.wanted()
            if profile and ok_profile(profile):
                target, reason = profile, name
                break
        if (target, reason) != (self.target, self.reason):
            log.info("target: %s (%s)", target, reason)
        self.target, self.reason = target, reason
        self.runner.request(target)
        self.emit_state()

    def _set_monitoring(self, on):
        if on:
            for n, s in self.sources.items():
                if not s.gate and n not in self.running:
                    s.start()
                    self.running.add(n)
        else:
            for n in list(self.running):
                self.all[n].stop()
                self.running.discard(n)
        self.monitoring = on
        log.info("monitoring %s", "resumed" if on else "paused (on battery)")

    def reload(self):
        """Config file changed (inotify) or Reload was called."""
        if not load_config():
            return
        enabled = set(self.sources)
        if self.monitoring:
            for n in list(self.running):
                if n not in enabled:
                    self.all[n].stop()
                    self.running.discard(n)
            for n, s in self.sources.items():
                if not s.gate and n not in self.running:
                    s.start()
                    self.running.add(n)
        for s in self.all.values():
            s.reconfigure()
        self.schedule(immediate=True)

    # --- suspend / resume ---------------------------------------------------
    def on_sleep(self, going_to_sleep):
        if going_to_sleep:
            log.info("suspend: hands off OpenRGB")
            self.sleeping = True
            self.settling = False
            self.settle_timer.cancel()
            self.eval_timer.cancel()
            self.runner.hold_off()
        elif self.sleeping:
            log.info("resume: settling for %d ms", RESUME_SETTLE_MS)
            self.sleeping = False
            self.settling = True
            self.settle_timer.restart(RESUME_SETTLE_MS)
        self.emit_state()

    def _after_resume(self):
        """AC may have been plugged/unplugged while asleep, and USB devices reset on suspend:
        re-read power state, restart monitors from scratch, then re-apply."""
        self.settling = False
        log.info("resume: re-reading power state")
        self.runner.resume()
        if self.monitoring:
            self._set_monitoring(False)
        self.all["ac"].resync()
        self.schedule()

    def quit(self, *_):
        self.loop.quit()
        return GLib.SOURCE_REMOVE


def main():
    if "--debug" in sys.argv or os.environ.get("RGB_DEBUG"):
        logging.getLogger().setLevel(logging.DEBUG)
    loop = GLib.MainLoop()
    ctl = Controller(loop)
    ctl.connect()
    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, ctl.quit)

    def lost(conn, name, *_):
        log.error("could not own %s (already running?)", BUS_NAME)
        loop.quit()

    Gio.bus_own_name_on_connection(
        ctl.session, BUS_NAME, Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
        lambda conn, name, *_: ctl.start(), lost,
    )
    loop.run()


if __name__ == "__main__":
    main()
