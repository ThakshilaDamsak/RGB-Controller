def config_path():
    return os.environ.get("RGB_CONTROLLER_CONFIG") or os.path.join(
        GLib.get_user_config_dir(), "rgb-controller", "config.toml"
    )


def _coerce(default, val):
    if isinstance(default, bool):
        if isinstance(val, bool):
            return val
    elif isinstance(default, int):
        if isinstance(val, int) and not isinstance(val, bool):
            return val
    elif isinstance(default, float):
        if isinstance(val, (int, float)) and not isinstance(val, bool):
            return float(val)
    elif isinstance(default, str):
        if isinstance(val, str):
            return val
    elif isinstance(default, tuple):
        if isinstance(val, list) and all(isinstance(x, (str, int, dict)) and not isinstance(x, bool) for x in val):
            return tuple(val)
    raise ValueError(f"expected {type(default).__name__}")


_config_hash = None


def load_config():
    """(Re)load overrides on top of the built-in defaults. Returns True if anything was (re)applied.
    A broken file never takes the daemon down: the previous settings stay in force."""
    global _config_hash
    path = config_path()
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except FileNotFoundError:
        raw = b""
    except OSError as e:
        log.error("config: cannot read %s: %s", path, e)
        return False
    digest = hashlib.sha1(raw).hexdigest()
    if digest == _config_hash:
        return False
    try:
        data = tomllib.loads(raw.decode("utf-8")) if raw.strip() else {}
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        log.error("config: %s is not valid TOML (%s), keeping the previous settings", path, e)
        _config_hash = digest  # do not spam the same error on every inotify event
        return False
    _config_hash = digest
    g = globals()
    for k, v in _DEFAULTS.items():
        g[k] = copy.deepcopy(v)
    for key, val in data.items():
        k = key.upper()
        if k not in _DEFAULTS:
            log.warning("config: unknown key %r ignored", key)
            continue
        try:
            g[k] = _coerce(_DEFAULTS[k], val)
        except ValueError as e:
            log.warning("config: %s: %s, using the default", key, e)
    if "ac" in PRIORITY:
        g["PRIORITY"] = tuple(n for n in PRIORITY if n != "ac")
    if raw.strip():
        log.info("config: loaded %s", path)
    return True


def ok_profile(name):
    """Profile names go to `openrgb --profile NAME` as one argv item; refuse anything option-shaped."""
    return isinstance(name, str) and 0 < len(name) <= 128 and not name.startswith("-") and "\0" not in name


load_config()

