class _Ring(logging.Handler):
    """Keeps the last lines for the GUI's log tab and forwards new ones as a D-Bus signal."""

    def __init__(self):
        super().__init__()
        self.lines = collections.deque(maxlen=300)
        self.sink = None

    def emit(self, record):
        line = f"{time.strftime('%H:%M:%S', time.localtime(record.created))} {record.getMessage()}"
        self.lines.append(line)
        if self.sink:
            try:
                self.sink(line)
            except Exception:
                pass


logging.basicConfig(level=logging.INFO, format="%(message)s")
