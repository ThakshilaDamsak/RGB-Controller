class ChainWidget(QWidget):
    """The priority chain as chips: who wins right now, who has an opinion but is outranked, who is idle."""

    def __init__(self):
        super().__init__()
        self.lay = QHBoxLayout(self)
        self.lay.setContentsMargins(0, 0, 0, 0)
        self.lay.setSpacing(6)

    def set_state(self, s):
        while self.lay.count():
            it = self.lay.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        wants = s.get("wants", {})
        on_batt = s["sources"].get("ac", {}).get("on_battery")
        winner = s.get("reason")
        first = True
        for name in s.get("order", []):
            if not first:
                arrow = QLabel("›")
                arrow.setStyleSheet("color: palette(placeholder-text);")
                self.lay.addWidget(arrow)
            first = False
            label = "AC power" if name == "ac" else SOURCE_INFO.get(name, (name, ""))[0]
            w = wants.get(name)
            if name == "ac":
                text = "On battery → " + (w or "?") if on_batt else "Plugged in"
            else:
                text = f"{label}  →  {w}" if w else label
            chip = QLabel(text)
            base = "padding: 4px 10px; border-radius: 11px;"
            if name == winner:
                chip.setStyleSheet(base + "background: palette(highlight); color: palette(highlighted-text); font-weight: bold;")
            elif w:
                chip.setStyleSheet(base + "border: 1px dashed palette(mid);")
            else:
                chip.setStyleSheet(base + "border: 1px solid palette(midlight); color: palette(placeholder-text);")
            self.lay.addWidget(chip)
        if winner == "fallback":
            arrow = QLabel("›")
            arrow.setStyleSheet("color: palette(placeholder-text);")
            self.lay.addWidget(arrow)
            chip = QLabel("Fallback  →  " + str(s.get("target")))
            chip.setStyleSheet("padding: 4px 10px; border-radius: 11px; background: palette(highlight); "
                               "color: palette(highlighted-text); font-weight: bold;")
            self.lay.addWidget(chip)
        self.lay.addStretch(1)


class LivePage(Page):
    editable = False

    def __init__(self, ctx, daemon, window):
        super().__init__()
        self.ctx, self.daemon, self.window_ = ctx, daemon, window
        self.state = None
        lay = QVBoxLayout(self)
        lay.addWidget(title("Live"))

        card = QFrame()
        card.setFrameShape(QFrame.Shape.StyledPanel)
        cl = QHBoxLayout(card)
        self.dot = QLabel()
        self.dot.setFixedSize(64, 64)
        cl.addWidget(self.dot)
        col = QVBoxLayout()
        self.now = QLabel("…")
        f = self.now.font()
        f.setPointSizeF(f.pointSizeF() * 2)
        f.setBold(True)
        self.now.setFont(f)
        self.why = QLabel("")
        self.applied = QLabel("")
        col.addWidget(self.now)
        col.addWidget(self.why)
        col.addWidget(self.applied)
        cl.addLayout(col, 1)
        lay.addWidget(card)

        lay.addWidget(QLabel("Priority, highest first:"))
        self.chain = ChainWidget()
        lay.addWidget(self.chain)

        pin = QGroupBox("Pin a profile")
        pl = QVBoxLayout(pin)
        row = QHBoxLayout()
        self.pin_combo = ProfileCombo(ctx)
        self.dur = QComboBox()
        for label, secs in PIN_DURATIONS:
            self.dur.addItem(label, secs)
        pin_btn, unpin_btn = QPushButton("Pin"), QPushButton("Unpin")
        row.addWidget(self.pin_combo, 1)
        row.addWidget(QLabel("for"))
        row.addWidget(self.dur)
        row.addWidget(pin_btn)
        row.addWidget(unpin_btn)
        pl.addLayout(row)
        self.quick = QGridLayout()
        pl.addLayout(self.quick)
        self.pin_state = hint("")
        pl.addWidget(self.pin_state)
        lay.addWidget(pin)
        pin_btn.clicked.connect(lambda: self.pin(self.pin_combo.value()))
        unpin_btn.clicked.connect(lambda: daemon.call("Unpin", cb=self._result))
        ctx.changed.connect(self._quick_buttons)
        self._quick_buttons()

        lay.addWidget(QLabel("Triggers:"))
        self.tree = QTreeWidget()
        self.tree.setHeaderLabels(["Source", "State", "Details"])
        self.tree.setRootIsDecorated(False)
        self.tree.header().setSectionResizeMode(2, QHeaderView.ResizeMode.Stretch)
        lay.addWidget(self.tree, 1)

        row = QHBoxLayout()
        re = QPushButton("Re-apply now")
        re.setToolTip("Forget what the lights are doing and apply the current profile again")
        re.clicked.connect(lambda: daemon.call("Reevaluate", cb=self._result))
        row.addWidget(re)
        row.addStretch(1)
        lay.addLayout(row)

    def _result(self, ok, payload):
        if not ok:
            self.window_.flash(f"Daemon said no: {payload}")

    def pin(self, profile):
        if profile:
            self.daemon.call("Pin", profile, int(self.dur.currentData()), cb=self._result)

    def _quick_buttons(self):
        while self.quick.count():
            self.quick.takeAt(0).widget().deleteLater()
        for i, name in enumerate(self.ctx.profiles):
            b = QPushButton(profile_icon(name), name)
            b.setIconSize(QSize(16, 16))
            b.clicked.connect(lambda _c=False, n=name: self.pin(n))
            self.quick.addWidget(b, i // 4, i % 4)

    def set_state(self, s):
        self.state = s
        target = s.get("target") or "…"
        self.dot.setPixmap(profile_pixmap(target, 64))
        self.now.setText(target)
        reason = s.get("reason", "")
        why = REASONS.get(reason, reason)
        if reason == "power":
            why += f" ({s['sources'].get('power', {}).get('mode') or 'unknown'})"
        self.why.setText(f"because {why}")
        if s.get("failing"):
            self.applied.setText("OpenRGB keeps failing, check the Log page")
            self.applied.setStyleSheet("color: #dc2626;")
        elif s.get("sleeping"):
            self.applied.setText("System is suspended or just resumed, lights are left alone")
            self.applied.setStyleSheet("")
        else:
            ap = s.get("applied")
            self.applied.setText(f"Applied to your devices: {ap}" if ap == target else f"Applying {target}…")
            self.applied.setStyleSheet("")
        self.chain.set_state(s)

        pin = s["sources"].get("pin", {})
        if pin.get("profile"):
            left = pin.get("remaining_s")
            until = (datetime.datetime.now() + datetime.timedelta(seconds=left)).strftime("%H:%M") if left is not None else None
            self.pin_state.setText(f"Pinned: {pin['profile']}" + (f" until {until}" if until else " until you unpin it"))
        else:
            self.pin_state.setText("Nothing pinned.")

        self.tree.clear()
        for name, d in s["sources"].items():
            label = "AC power" if name == "ac" else SOURCE_INFO.get(name, (name, ""))[0]
            enabled = name in s.get("order", [])
            if name == "ac":
                st, det = ("On battery" if d.get("on_battery") else "Plugged in"), ""
            elif name == "loading":
                st = "Active" if d.get("confirmed") else "Idle"
                det = ", ".join(d.get("progress", []) + d.get("holds", [])) or ""
            elif name == "gaming":
                st, det = ("Running" if d.get("holds") else "Idle"), ", ".join(d.get("holds", []))
            elif name == "media":
                playing = [k for k, v in d.items() if v == "Playing"]
                st, det = ("Playing" if playing else "Idle"), ", ".join(f"{k}: {v}" for k, v in d.items())
            elif name == "pin":
                st, det = ("Pinned" if d.get("profile") else "Idle"), d.get("profile") or ""
            elif name == "schedule":
                st, det = ("Window active" if d.get("active") else "Idle"), f"{d.get('windows', 0)} window(s)"
            elif name == "power":
                st, det = (d.get("mode") or "unknown"), ""
            else:
                st, det = "", json.dumps(d)
            if not enabled:
                st = "disabled"
            item = QTreeWidgetItem([label, st, det])
            if not enabled:
                for c in range(3):
                    item.setForeground(c, self.palette().placeholderText())
            self.tree.addTopLevelItem(item)
        for c in (0, 1):
            self.tree.resizeColumnToContents(c)


class ProfilesPage(Page):
    ROWS = [
        ("Power profile mapping", None, None),
        ("profile_default", "Balanced mode (and fallback)", "What the lights do when nothing else is going on and the power profile is Balanced."),
        ("profile_performance", "Performance mode", "Fallback while power-profiles-daemon is in Performance."),
        ("profile_power_saver", "Power-saver mode", "Fallback in Power saver while plugged in. On battery everything is off anyway."),
        ("Situations", None, None),
        ("profile_battery", "On battery", "Applied the moment you unplug. Everything else is paused until you plug in again."),
        ("profile_loading", "Loading", "Progress bars, package manager jobs."),
        ("profile_gaming", "Gaming", "While a game started through game-rgb is running."),
        ("profile_spotify", "Spotify playing", ""),
        ("profile_other_media", "Other media playing", "Browser video, mpv, VLC... (anything MPRIS that is not Spotify)."),
    ]

    def __init__(self, ctx, daemon):
        super().__init__()
        self.ctx, self.daemon = ctx, daemon
        self.combos = {}
        lay = QVBoxLayout(self)
        lay.addWidget(title("Profiles"))
        lay.addWidget(hint("Pick which saved OpenRGB profile goes with each situation. Orange border = no profile "
                           "with that name found in OpenRGB. ▶ shows it on your lights for 6 seconds."))
        form = QGridLayout()
        r = 0
        for key, label, desc in self.ROWS:
            if label is None:
                head = QLabel(f"<b>{key}</b>")
                form.addWidget(head, r, 0, 1, 3)
                r += 1
                continue
            combo = ProfileCombo(ctx)
            combo.changed.connect(self.changed)
            self.combos[key] = combo
            prev = QToolButton()
            prev.setText("▶")
