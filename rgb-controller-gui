class RowHeightDelegate(QStyledItemDelegate):
    """Gives every row a minimum height while leaving the width to the style (so columns still size to contents)."""

    def __init__(self, height, parent=None):
        super().__init__(parent)
        self._h = height

    def sizeHint(self, option, index):
        s = super().sizeHint(option, index)
        return QSize(s.width(), max(s.height(), self._h))


class ProfileDelegate(QStyledItemDelegate):
    """Draws the colour dot in the popup list. The items carry no icon of their own, so the closed combo
    never paints a second, stale dot next to the one in its line edit."""

    def initStyleOption(self, option, index):
        super().initStyleOption(option, index)
        option.icon = profile_icon(index.data(Qt.ItemDataRole.DisplayRole))
        option.features |= QStyleOptionViewItem.ViewItemFeature.HasDecoration
        option.decorationSize = QSize(16, 16)


class ProfileCombo(QComboBox):
    """Editable combo of OpenRGB profile names. The line edit shows the profile's colour dot (hidden while
    empty) and a warning icon when the name is not saved in OpenRGB."""
    changed = Signal()

    def __init__(self, ctx, allow_empty=False):
        super().__init__()
        self.ctx = ctx
        self.allow_empty = allow_empty
        self.setEditable(True)
        self.setMinimumWidth(190)
        self.setSizeAdjustPolicy(QComboBox.SizeAdjustPolicy.AdjustToContentsOnFirstShow)
        self.setItemDelegate(ProfileDelegate(self))
        le = self.lineEdit()
        self._lead = le.addAction(profile_icon("x"), QLineEdit.ActionPosition.LeadingPosition)
        self._lead.setVisible(False)
        self._warn = le.addAction(icon("dialog-warning"), QLineEdit.ActionPosition.TrailingPosition)
        self._warn.setVisible(False)
        ctx.changed.connect(self._refill)
        self.editTextChanged.connect(lambda _t: (self._flag(), self.changed.emit()))
        self._refill()

    def _refill(self):
        text = self.currentText()
        self.blockSignals(True)
        self.clear()
        self.addItems(self.ctx.profiles)
        self.setCurrentIndex(-1)
        self.setEditText(text)
        self.blockSignals(False)
        self._flag()

    def _flag(self):
        text = self.currentText()
        missing = bool(self.ctx.profiles) and bool(text) and text not in self.ctx.profiles
        self._lead.setIcon(profile_icon(text))
        self._lead.setVisible(bool(text))
        self._warn.setVisible(missing)
        tip = f"'{text}' is not saved in OpenRGB yet (profiles found: {len(self.ctx.profiles)})" if missing else ""
        self._warn.setToolTip(tip)
        self.setToolTip(tip)

    def value(self):
        return self.currentText().strip()

    def set_value(self, v):
        self.blockSignals(True)
        self.setEditText(v)
        self.blockSignals(False)
        self._flag()


class StringList(QWidget):
    changed = Signal()

    def __init__(self, placeholder=""):
        super().__init__()
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(6)
        self.list = QListWidget()
        self.list.setMinimumHeight(64)
        self.list.setMaximumHeight(100)
        self.list.setAlternatingRowColors(True)
        self.list.setSelectionMode(QAbstractItemView.SelectionMode.ExtendedSelection)
        row = QHBoxLayout()
        self.edit = QLineEdit()
        self.edit.setPlaceholderText(placeholder)
        self.edit.setClearButtonEnabled(True)
        add, rem = push("Add", "list-add"), push("Remove", "list-remove")
        row.addWidget(self.edit, 1)
        row.addWidget(add)
        row.addWidget(rem)
        lay.addWidget(boxed(self.list))
        lay.addLayout(row)
        add.clicked.connect(self._add)
        self.edit.returnPressed.connect(self._add)
        rem.clicked.connect(self._remove)

    def _add(self):
        t = self.edit.text().strip()
        if t and t not in self.get():
            self.list.addItem(t)
            self.edit.clear()
            self.changed.emit()

    def _remove(self):
        for it in self.list.selectedItems():
            self.list.takeItem(self.list.row(it))
        self.changed.emit()

    def get(self):
        return [self.list.item(i).text() for i in range(self.list.count())]

    def set(self, items):
        self.list.clear()
        self.list.addItems([str(i) for i in items])


