def scale_font(widget, factor, bold=False):
    f = widget.font()
    if f.pointSizeF() > 0:
        f.setPointSizeF(f.pointSizeF() * factor)
    elif f.pixelSize() > 0:
        f.setPixelSize(int(f.pixelSize() * factor))
    f.setBold(bold)
    widget.setFont(f)


def dim(widget):
    """Secondary text colour straight from the theme."""
    widget.setForegroundRole(QPalette.ColorRole.PlaceholderText)
    return widget


def hint(text):
    lab = QLabel(text)
    lab.setWordWrap(True)
    return dim(lab)


def wrap_label(text):
    lab = QLabel(text)
