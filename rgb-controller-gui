class ChainWidget(QWidget):
    """The priority chain as chips: who wins right now, who has an opinion but is outranked, who is idle."""

    def __init__(self):
        super().__init__()
        self.flow = FlowLayout(self, spacing=6)

    def _arrow(self):
        arrow = QLabel("›")
        scale_font(arrow, 1.3)
        dim(arrow)
        self.flow.addWidget(arrow)

    def set_state(self, s):
        self.flow.clear()
        wants = s.get("wants", {})
        on_batt = s["sources"].get("ac", {}).get("on_battery")
        winner = s.get("reason")
        first = True
        for name in s.get("order", []):
            if not first:
                self._arrow()
            first = False
            label = "AC power" if name == "ac" else SOURCE_INFO.get(name, (name, ""))[0]
            w = wants.get(name)
            if name == "ac":
                text = "On battery → " + (w or "?") if on_batt else "Plugged in"
            else:
                text = f"{label}  →  {w}" if w else label
            kind = "win" if name == winner else ("wants" if w else "idle")
            self.flow.addWidget(Chip(text, kind))
        if winner == "fallback":
            self._arrow()
            self.flow.addWidget(Chip("Fallback  →  " + str(s.get("target")), "win"))


