    def _fill(self, enabled, all_names):
        self.list.blockSignals(True)
        self.list.clear()
        for name in list(enabled) + [n for n in all_names if n not in enabled]:
            if name not in SOURCE_INFO:
                continue
            it = QListWidgetItem()
            it.setData(Qt.ItemDataRole.UserRole, name)
            it.setFlags(it.flags() | Qt.ItemFlag.ItemIsUserCheckable | Qt.ItemFlag.ItemIsDragEnabled)
            it.setCheckState(Qt.CheckState.Checked if name in enabled else Qt.CheckState.Unchecked)
            self.list.addItem(it)
        self.list.blockSignals(False)
        self._renumber()

    def _renumber(self):
        n = 1
        for i in range(self.list.count()):
            it = self.list.item(i)
            name = it.data(Qt.ItemDataRole.UserRole)
            label, desc = SOURCE_INFO[name]
            on = it.checkState() == Qt.CheckState.Checked
            it.setText(f"{n + 1}.  {label}\n      {desc}" if on else f"–.  {label}   (disabled)\n      {desc}")
            if on:
                n += 1

    def _reset(self):
        self._fill(self.defaults.get("priority", []), list(SOURCE_INFO))
        self.changed.emit()

    def load(self, v):
        self.defaults = v.get("__defaults__", {})
        self._fill(v.get("priority", []), list(SOURCE_INFO))

    def dump(self, v):
        v["priority"] = [self.list.item(i).data(Qt.ItemDataRole.UserRole) for i in range(self.list.count())
                         if self.list.item(i).checkState() == Qt.CheckState.Checked]


