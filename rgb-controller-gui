# ═══════════════════════════════ colours & icons ═══════════════════════════════
def profile_color(name):
    n = (name or "").lower()
    for key, col in (("game", "#ef4444"), ("load", "#3b82f6"), ("perf", "#f97316"), ("default", "#22c55e"),
                     ("vomit", "#a3e635"), ("night", "#6366f1"), ("battery", "#9ca3af")):
        if key in n:
            return QColor(col)
    h = sum(ord(c) * (i + 7) for i, c in enumerate(n)) % 360
    return QColor.fromHsvF(h / 360, 0.65, 0.9)


def profile_pixmap(name, size=32):
    pm = QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    m = size * 0.1
    r = QRectF(m, m, size - 2 * m, size - 2 * m)
    n = (name or "").lower()
    if "rainbow" in n:
        g = QConicalGradient(r.center(), 90)
        for i in range(7):
            g.setColorAt(i / 6, QColor.fromHsvF((i / 6) % 1.0 if i < 6 else 0.0, 0.85, 1.0))
        p.setBrush(QBrush(g))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(r)
    elif not name or n == "off":
        pen = QPen(QColor("#9ca3af"), max(1.5, size * 0.12))
        p.setPen(pen)
        p.setBrush(Qt.BrushStyle.NoBrush)
        half = pen.widthF() / 2
        p.drawEllipse(r.adjusted(half, half, -half, -half))
    else:
        p.setBrush(profile_color(name))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(r)
        p.setBrush(QColor(255, 255, 255, 70))
        p.drawEllipse(QRectF(r.left() + r.width() * 0.2, r.top() + r.height() * 0.12, r.width() * 0.4, r.height() * 0.28))
    p.end()
    return pm


def profile_icon(name):
    ic = QIcon()
    for s in (16, 22, 32, 48, 64):
        ic.addPixmap(profile_pixmap(name, s))
    return ic


def app_icon():
    themed = QIcon.fromTheme("rgb-controller")
    return themed if not themed.isNull() else profile_icon("rainbow")


# ═══════════════════════════════ config helpers ═══════════════════════════════
def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v)
    if isinstance(v, (list, tuple)):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ", ".join(f"{toml_key(k)} = {toml_value(x)}" for k, x in v.items()) + "}"
    raise TypeError(f"cannot write {type(v).__name__} to TOML")


def toml_key(k):
    return k if k and all(c.isalnum() or c in "_-" for c in k) else json.dumps(k)


def dump_toml(overrides):
    return CONFIG_HEADER + "\n" + "".join(f"{toml_key(k)} = {toml_value(v)}\n" for k, v in sorted(overrides.items()))


def scan_profiles():
    """OpenRGB keeps one <name>.orp per profile in its config dir (native or flatpak)."""
    home = os.path.expanduser("~")
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    dirs = [os.path.join(cfg, "OpenRGB"), os.path.join(home, ".var/app/org.openrgb.OpenRGB/config/OpenRGB")]
    names = {}
    for d in dirs:
        for pattern in ("*.orp", "profiles/*.orp"):
            for f in glob.glob(os.path.join(d, pattern)):
                stem = os.path.splitext(os.path.basename(f))[0]
                names.setdefault(stem.lower(), stem)
    return sorted(names.values(), key=str.lower), [d for d in dirs if os.path.isdir(d)]


def gui_prefs_path():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "rgb-controller", "gui.json")


def load_prefs():
    prefs = {"close_to_tray": True, "tray_color": True, "told_about_tray": False}
    try:
        with open(gui_prefs_path()) as f:
            prefs.update(json.load(f))
    except (OSError, ValueError):
        pass
    return prefs


def save_prefs(prefs):
    try:
        os.makedirs(os.path.dirname(gui_prefs_path()), exist_ok=True)
        with open(gui_prefs_path(), "w") as f:
            json.dump(prefs, f)
    except OSError:
        pass


# ═══════════════════════════════ D-Bus client ═══════════════════════════════
class DaemonClient(QObject):
    state = Signal(dict)
    logline = Signal(str)
    availability = Signal(bool)

    def __init__(self):
        super().__init__()
        self.bus = QDBusConnection.sessionBus()
        self.alive = bool(self.bus.interface().isServiceRegistered(SERVICE).value())
        self.watcher = QDBusServiceWatcher(
            SERVICE, self.bus,
            QDBusServiceWatcher.WatchModeFlag.WatchForRegistration | QDBusServiceWatcher.WatchModeFlag.WatchForUnregistration,
            self,
        )
        self.watcher.serviceRegistered.connect(lambda *_: self._set_alive(True))
        self.watcher.serviceUnregistered.connect(lambda *_: self._set_alive(False))
        self.bus.connect(SERVICE, OBJ_PATH, IFACE, "StateChanged", self, "1_on_state(QString)")
        self.bus.connect(SERVICE, OBJ_PATH, IFACE, "Log", self, "1_on_log(QString)")

    def _set_alive(self, alive):
        if alive != self.alive:
            self.alive = alive
            self.availability.emit(alive)

    @Slot(str)
    def _on_state(self, js):
        try:
            self.state.emit(json.loads(js))
        except ValueError:
            pass

    @Slot(str)
    def _on_log(self, line):
        self.logline.emit(line)

    def call(self, method, *args, cb=None):
        msg = QDBusMessage.createMethodCall(SERVICE, OBJ_PATH, IFACE, method)
        if args:
            msg.setArguments(list(args))
        watcher = QDBusPendingCallWatcher(self.bus.asyncCall(msg, 5000), self)
        watcher.finished.connect(lambda w=watcher: self._done(w, cb))

    def _done(self, watcher, cb):
        reply = watcher.reply()
        ok = reply.type() == QDBusMessage.MessageType.ReplyMessage
        args = reply.arguments()
        payload = (args[0] if args else None) if ok else (reply.errorMessage() or reply.errorName())
        watcher.deleteLater()
        if cb:
            cb(ok, payload)

    def call_json(self, method, cb):
        def done(ok, payload):
            if ok:
                try:
                    return cb(True, json.loads(payload))
                except ValueError:
                    pass
            cb(False, payload)
        self.call(method, cb=done)


class Ctx(QObject):
    """Shared by all pages: the list of OpenRGB profile names found on disk."""
    changed = Signal()

    def __init__(self):
        super().__init__()
        self.profiles, self.dirs = [], []
        self.rescan()

    def rescan(self):
        self.profiles, self.dirs = scan_profiles()
        self.changed.emit()


def run_async(parent, program, args, cb):
    proc = QProcess(parent)
    proc.finished.connect(lambda code, _s, p=proc: (cb(code == 0, bytes(p.readAllStandardOutput()).decode().strip()
                                                      or bytes(p.readAllStandardError()).decode().strip()), p.deleteLater()))
    proc.errorOccurred.connect(lambda _e, p=proc: (cb(False, p.errorString()), p.deleteLater()))
    proc.start(program, args)


