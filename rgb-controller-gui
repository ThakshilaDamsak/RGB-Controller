    # --- values --------------------------------------------------------------------
    def load(self, v):
        self.config_path = v.get("__path__", "")
        self.path_lab.setText(self.config_path)
        self.cmd.blockSignals(True)
        self.cmd.setText(shlex.join(v.get("openrgb_cmd", ["openrgb"])))
        self.cmd.blockSignals(False)

    def dump(self, v):
        try:
            parts = shlex.split(self.cmd.text())
        except ValueError:
            parts = []
        v["openrgb_cmd"] = parts or ["openrgb"]

    # --- helpers -------------------------------------------------------------------
    def _test(self):
        try:
            argv = shlex.split(self.cmd.text()) or ["openrgb"]
        except ValueError as e:
            return self.window_.flash(f"Cannot parse the command: {e}")
        run_async(self, argv[0], [*argv[1:], "--version"], lambda ok, out: self.window_.flash(
            (f"OK: {out.splitlines()[0]}" if out else "OK") if ok else f"Failed: {out[:200]}"))

    def systemctl(self, action):
        def done(ok, out):
            if not ok and action in ("start", "restart"):
                QProcess.startDetached("rgb-controller", [])  # not installed as a service: run it directly
                self.window_.flash("systemd unit not found, started the daemon directly")
            elif not ok:
                self.window_.flash(f"systemctl {action}: {out[:200]}")
            self.refresh_system()
        run_async(self, "systemctl", ["--user", action, UNIT], done)

    def refresh_system(self):
        run_async(self, "systemctl", ["--user", "is-enabled", UNIT], lambda ok, out: self.d_enabled.setChecked(out == "enabled"))
        self.dstate.setText("Running" if self.daemon.alive else "Not running")

    def _autostart_path(self):
        return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "autostart", "rgb-controller-gui.desktop")

    def _autostart(self, on):
        path = self._autostart_path()
        try:
            if on:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w") as f:
                    f.write("[Desktop Entry]\nType=Application\nName=RGB Controller (tray)\nExec=rgb-controller-gui --tray\n"
                            "Icon=rgb-controller\nTerminal=false\nX-GNOME-Autostart-enabled=true\n")
            elif os.path.exists(path):
                os.remove(path)
        except OSError as e:
            self.window_.flash(f"Autostart: {e}")

    def sync_prefs(self, prefs):
        self.close_tray.setChecked(prefs["close_to_tray"])
        self.tray_color.setChecked(prefs["tray_color"])
        self.autostart.setChecked(os.path.exists(self._autostart_path()))

    def _open_file(self):
        if self.config_path:
            if not os.path.exists(self.config_path):
                self.window_.save_overrides({})
            QDesktopServices.openUrl(QUrl.fromLocalFile(self.config_path))

    def _open_dir(self):
        if self.config_path:
            QDesktopServices.openUrl(QUrl.fromLocalFile(os.path.dirname(self.config_path)))

    def _export(self):
        dest, _ = QFileDialog.getSaveFileName(self, "Export config", "rgb-controller-config.toml", "TOML (*.toml)")
        if dest and self.config_path and os.path.exists(self.config_path):
            with open(self.config_path, "rb") as src, open(dest, "wb") as out:
                out.write(src.read())
            self.window_.flash(f"Exported to {dest}")

    def _import(self):
        src, _ = QFileDialog.getOpenFileName(self, "Import config", "", "TOML (*.toml)")
        if src and self.config_path:
            with open(src, "rb") as f:
                self.window_.write_raw(f.read())

    def _reset(self):
        if QMessageBox.question(self, "Reset", "Forget all your settings and go back to the built-in defaults?") == QMessageBox.StandardButton.Yes:
            self.window_.save_overrides({})


class LogPage(Page):
    editable = False

    def __init__(self, daemon):
        super().__init__()
        lay = QVBoxLayout(self)
        lay.addWidget(title("Log"))
        row = QHBoxLayout()
        self.filter = QLineEdit()
        self.filter.setPlaceholderText("filter…")
        self.filter.textChanged.connect(self._refilter)
        clear = QPushButton("Clear")
        clear.clicked.connect(self._clear)
        copy_b = QPushButton("Copy")
        copy_b.clicked.connect(lambda: QApplication.clipboard().setText(self.view.toPlainText()))
        row.addWidget(self.filter, 1)
        row.addWidget(clear)
        row.addWidget(copy_b)
        lay.addLayout(row)
        self.view = QPlainTextEdit()
        self.view.setReadOnly(True)
        self.view.setMaximumBlockCount(2000)
        f = QFont("monospace")
        f.setStyleHint(QFont.StyleHint.Monospace)
        self.view.setFont(f)
        lay.addWidget(self.view, 1)
        self.lines = []
        daemon.logline.connect(self.add)

    def _matches(self, line):
        return self.filter.text().lower() in line.lower()

    def add(self, line):
        self.lines.append(line)
        self.lines = self.lines[-2000:]
        if self._matches(line):
            self.view.appendPlainText(line)

    def set_history(self, lines):
        self.lines = list(lines)
        self._refilter()

    def _refilter(self):
        self.view.setPlainText("\n".join(l for l in self.lines if self._matches(l)))
        self.view.verticalScrollBar().setValue(self.view.verticalScrollBar().maximum())

    def _clear(self):
        self.lines = []
        self.view.clear()


# ═══════════════════════════════ main window ═══════════════════════════════
class Window(QMainWindow):
    def __init__(self, app, daemon, ctx, prefs):
        super().__init__()
        self.app, self.daemon, self.ctx, self.prefs = app, daemon, ctx, prefs
        self.values, self.defaults, self.config_path = {}, {}, ""
        self.config_version = None
        self.dirty = False
        self.state = None
        self.tray = None
        self.setWindowTitle("RGB Controller")
        self.setWindowIcon(app_icon())
        self.resize(1040, 720)

        root = QWidget()
        outer = QVBoxLayout(root)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        self.banner = QFrame()
        self.banner.setStyleSheet("background: #b45309; color: white;")
        bl = QHBoxLayout(self.banner)
        bl.addWidget(QLabel("The rgb-controller daemon is not running, so nothing is switching your lights."))
        bl.addStretch(1)
        start = QPushButton("Start it")
        start.clicked.connect(lambda: self.advanced.systemctl("start"))
        bl.addWidget(start)
        outer.addWidget(self.banner)

        mid = QHBoxLayout()
        mid.setContentsMargins(0, 0, 0, 0)
        self.nav = QListWidget()
        self.nav.setFixedWidth(170)
        self.nav.setIconSize(QSize(18, 18))
        self.stack = QStackedWidget()
        mid.addWidget(self.nav)
        mid.addWidget(self.stack, 1)
        outer.addLayout(mid, 1)

        bar = QFrame()
        bar.setFrameShape(QFrame.Shape.StyledPanel)
        bb = QHBoxLayout(bar)
        self.dirty_lab = QLabel("")
        self.revert_btn, self.apply_btn = QPushButton("Revert"), QPushButton("Apply")
        self.apply_btn.setDefault(True)
        bb.addWidget(self.dirty_lab, 1)
        bb.addWidget(self.revert_btn)
        bb.addWidget(self.apply_btn)
        outer.addWidget(bar)
        self.bar = bar
        self.setCentralWidget(root)
        self.status = self.statusBar()

        self.live = LivePage(ctx, daemon, self)
        self.profiles = ProfilesPage(ctx, daemon)
        self.priority = PriorityPage(ctx, daemon)
        self.triggers = TriggersPage(ctx, daemon)
        self.schedule = SchedulePage(ctx, daemon)
        self.timing = TimingPage(ctx, daemon)
        self.advanced = AdvancedPage(ctx, daemon, self)
        self.logpage = LogPage(daemon)
        self.pages = [("Live", self.live), ("Profiles", self.profiles), ("Priority", self.priority),
                      ("Triggers", self.triggers), ("Schedule", self.schedule), ("Timing", self.timing),
                      ("Advanced", self.advanced), ("Log", self.logpage)]
        for name, page in self.pages:
            self.nav.addItem(name)
            self.stack.addWidget(page)
            if page.editable:
                page.changed.connect(self.mark_dirty)
        self.nav.currentRowChanged.connect(self._page_changed)
        self.nav.setCurrentRow(0)
        self.apply_btn.clicked.connect(self.apply)
        self.revert_btn.clicked.connect(self.revert)

        daemon.state.connect(self.on_state)
        daemon.availability.connect(self.on_availability)
        self.advanced.sync_prefs(prefs)
        self.on_availability(daemon.alive)
        self.mark_dirty(False)

    # --- daemon connection ----------------------------------------------------------------
    def on_availability(self, alive):
        self.banner.setVisible(not alive)
        self.advanced.refresh_system()
        if alive:
            self.fetch_config()
            self.daemon.call("Status", cb=lambda ok, js: ok and self.on_state(json.loads(js)))
            self.daemon.call_json("History", lambda ok, lines: ok and self.logpage.set_history(lines))
        else:
            self.live.dot.setPixmap(profile_pixmap(None, 64))
            self.live.now.setText("Daemon offline")
            self.live.why.setText("")
            self.live.applied.setText("")
            self.update_tray(None)

    def fetch_config(self):
        def got(ok, cfg):
            if not ok:
                return self.flash(f"Could not read the daemon config: {cfg}")
            self.values = cfg["values"]
            self.defaults = cfg["defaults"]
            self.config_path = cfg["path"]
            self.revert()
        self.daemon.call_json("Config", got)

    def on_state(self, s):
        self.state = s
        self.live.set_state(s)
        self.update_tray(s)
        if self.config_version is None:
            self.config_version = s.get("config")
        elif s.get("config") != self.config_version:  # edited by hand, or by a second GUI
            self.config_version = s.get("config")
            if not self.dirty:
                self.fetch_config()

    # --- editing ----------------------------------------------------------------------------
    def _page_changed(self, row):
        self.stack.setCurrentIndex(row)
        self.bar.setVisible(self.pages[row][1].editable)
        if self.pages[row][0] == "Advanced":
            self.advanced.refresh_system()

    def mark_dirty(self, dirty=True):
        self.dirty = bool(dirty)
        self.apply_btn.setEnabled(self.dirty)
        self.revert_btn.setEnabled(self.dirty)
        self.dirty_lab.setText("Unsaved changes" if self.dirty else "")

    def collect(self):
        vals = copy.deepcopy(self.values)
        for _n, page in self.pages:
            if page.editable:
                page.dump(vals)
        return vals

    def revert(self):
        v = dict(self.values)
        v["__defaults__"] = self.defaults
        v["__path__"] = self.config_path
        for _n, page in self.pages:
            if page.editable:
                page.load(v)
        self.mark_dirty(False)

    def apply(self):
        vals = self.collect()
        overrides = {k: val for k, val in vals.items() if val != self.defaults.get(k)}
        self.save_overrides(overrides)

    def save_overrides(self, overrides):
        self.write_raw(dump_toml(overrides).encode())

    def write_raw(self, raw):
        path = self.config_path
        if not path:
            return self.flash("Daemon not connected, cannot find the config file")
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            if os.path.exists(path):
                with open(path, "rb") as f:
                    old = f.read()
                if CONFIG_HEADER.splitlines()[0].encode() not in old and old.strip():
                    with open(path + ".bak", "wb") as b:  # a hand-written file: keep a copy of it once
                        b.write(old)
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".config-", suffix=".toml")
            with os.fdopen(fd, "wb") as f:
                f.write(raw)
            os.replace(tmp, path)
        except OSError as e:
            return self.flash(f"Could not save: {e}")
        self.daemon.call("Reload", cb=lambda ok, p: (self.flash("Saved and applied" if ok else f"Saved, but the daemon is not answering: {p}"),
                                                     ok and self.fetch_config()))

    def flash(self, text):
        self.status.showMessage(text, 6000)

    def set_pref(self, key, value):
        self.prefs[key] = value
        save_prefs(self.prefs)
        if self.tray:
            self.update_tray(self.state)

    # --- tray ---------------------------------------------------------------------------------
    def attach_tray(self, tray):
        self.tray = tray
        self.menu = QMenu()
        tray.setContextMenu(self.menu)
        tray.activated.connect(lambda r: r in (QSystemTrayIcon.ActivationReason.Trigger,) and self.toggle())
        self.ctx.changed.connect(lambda: self.update_tray(self.state))
        self.update_tray(self.state)
        tray.show()

    def toggle(self):
        if self.isVisible() and not self.isMinimized():
            self.hide()
        else:
            self.bring_up()

    def bring_up(self):
        self.show()
        self.setWindowState(self.windowState() & ~Qt.WindowState.WindowMinimized)
        self.raise_()
        self.activateWindow()

    def update_tray(self, s):
        if not self.tray:
            return
        target = (s or {}).get("target")
        self.tray.setIcon(profile_icon(target if self.prefs["tray_color"] else "rainbow") if s else profile_icon(None))
        if s:
            why = REASONS.get(s.get("reason"), s.get("reason", ""))
            self.tray.setToolTip(f"RGB: {target}\nbecause {why}")
        else:
            self.tray.setToolTip("RGB Controller: daemon not running")
        m = self.menu
        m.clear()
        head = m.addAction(profile_icon(target), f"{target}" if s else "Daemon not running")
        head.setEnabled(False)
        m.addAction("Open RGB Controller", self.bring_up)
        m.addSeparator()
        if s:
            pin_menu = m.addMenu("Pin a profile")
            for name in self.ctx.profiles:
                sub = pin_menu.addMenu(profile_icon(name), name)
                for label, secs in PIN_DURATIONS[:1] + PIN_DURATIONS[2:5]:
                    sub.addAction(label, lambda n=name, sc=secs: self.daemon.call("Pin", n, sc))
            if "Off" in self.ctx.profiles:
                m.addAction("Lights off for 1 hour", lambda: self.daemon.call("Pin", "Off", 3600))
            pinned = bool(s["sources"].get("pin", {}).get("profile"))
            un = m.addAction("Unpin", lambda: self.daemon.call("Unpin"))
            un.setEnabled(pinned)
            m.addSeparator()
        else:
            m.addAction("Start the daemon", lambda: self.advanced.systemctl("start"))
            m.addSeparator()
        m.addAction("Open OpenRGB", lambda: QProcess.startDetached("openrgb", []))
        m.addAction("Quit this window (daemon keeps running)", self.app.quit)

    # --- closing --------------------------------------------------------------------------------
    def closeEvent(self, ev):
        if self.tray and self.tray.isVisible() and self.prefs["close_to_tray"]:
            ev.ignore()
            self.hide()
            if not self.prefs["told_about_tray"]:
                self.prefs["told_about_tray"] = True
                save_prefs(self.prefs)
                self.tray.showMessage("RGB Controller", "Still running in the tray. The daemon keeps switching your lights "
                                      "even if you quit this window.", QSystemTrayIcon.MessageIcon.Information, 6000)
        else:
            ev.accept()
            self.app.quit()


def main(argv=None):
    argv = list(sys.argv if argv is None else argv)
    start_hidden = "--tray" in argv
    app = QApplication(argv)
    app.setApplicationName("RGB Controller")
    app.setDesktopFileName(APP_ID)
    app.setQuitOnLastWindowClosed(False)

    # single instance: a second launch just raises the first window
    sock_name = f"{APP_ID}-{os.getuid()}"
    probe = QLocalSocket()
    probe.connectToServer(sock_name)
    if probe.waitForConnected(300):
        probe.write(b"show")
        probe.flush()
        probe.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(sock_name)
    server = QLocalServer()
    server.listen(sock_name)

    prefs = load_prefs()
    daemon = DaemonClient()
    ctx = Ctx()
    win = Window(app, daemon, ctx, prefs)
    server.newConnection.connect(lambda: (server.nextPendingConnection().deleteLater(), win.bring_up()))
    if QSystemTrayIcon.isSystemTrayAvailable():
        win.attach_tray(QSystemTrayIcon())
    else:
        start_hidden = False
    if not start_hidden:
        win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
