def check_row(box, desc=""):
    """Checkbox with an optional wrapping description lined up under its text."""
    w = QWidget()
    v = QVBoxLayout(w)
    v.setContentsMargins(0, 0, 0, 0)
    v.setSpacing(0)
    v.addWidget(box)
    if desc:
        st = box.style()
        indent = st.pixelMetric(QStyle.PixelMetric.PM_IndicatorWidth) + st.pixelMetric(QStyle.PixelMetric.PM_CheckBoxLabelSpacing)
        h = hint(desc)
        h.setContentsMargins(indent, 0, 0, 4)
        v.addWidget(h)
    return w


