        self.quick.clear()
        self.tiles = {}
        for name in self.ctx.profiles:
            b = QToolButton()
            b.setIcon(profile_icon(name))
            b.setIconSize(QSize(32, 32))
            b.setText(name)
            b.setToolTip(f"Pin {name}")
            b.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextUnderIcon)
            b.setCheckable(True)
            b.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
            b.clicked.connect(lambda _c=False, n=name: (self.pin(n), self._sync_tiles()))
            self.tiles[name] = b
            self.quick.addWidget(b)
        self._sync_tiles()

    def _sync_tiles(self):
        target = (self.state or {}).get("target")
        for n, b in self.tiles.items():
            b.blockSignals(True)
            b.setChecked(n == target)
            b.blockSignals(False)

    def _set_applied(self, text, icon_names, role=QPalette.ColorRole.WindowText):
        self.applied.setText(text)
        self.applied.setForegroundRole(role)
        self.applied_icon.setPixmap(icon(*icon_names).pixmap(QSize(16, 16)))

    def set_state(self, s):
        self.state = s
        target = s.get("target") or "…"
        self.dot.setPixmap(profile_pixmap(target, 72))
        self.now.setText(target)
        reason = s.get("reason", "")
        why = REASONS.get(reason, reason)
        if reason == "power":
            why += f" ({s['sources'].get('power', {}).get('mode') or 'unknown'})"
        self.why.setText(f"because {why}")
        if s.get("failing"):
            self._set_applied("OpenRGB keeps failing, check the Log page", ("dialog-error",), QPalette.ColorRole.BrightText)
        elif s.get("sleeping"):
            self._set_applied("System is suspended or just resumed, lights are left alone", ("media-playback-pause",))
        else:
            ap = s.get("applied")
            if ap == target:
                self._set_applied(f"Applied to your devices: {ap}", ("dialog-ok-apply", "emblem-ok-symbolic"))
            else:
                self._set_applied(f"Applying {target}…", ("view-refresh", "process-working"))
        self.chain.set_state(s)
        self._sync_tiles()

        pin = s["sources"].get("pin", {})
        if pin.get("profile"):
            left = pin.get("remaining_s")
            until = (datetime.datetime.now() + datetime.timedelta(seconds=left)).strftime("%H:%M") if left is not None else None
            self.pin_state.setText(f"Pinned: {pin['profile']}" + (f" until {until}" if until else " until you unpin it"))
        else:
            self.pin_state.setText("Nothing pinned.")

        self.tree.clear()
        for name, d in s["sources"].items():
            label = "AC power" if name == "ac" else SOURCE_INFO.get(name, (name, ""))[0]
            enabled = name in s.get("order", [])
            if name == "ac":
                st, det = ("On battery" if d.get("on_battery") else "Plugged in"), ""
            elif name == "loading":
                st = "Active" if d.get("confirmed") else "Idle"
                det = ", ".join(d.get("progress", []) + d.get("holds", [])) or ""
            elif name == "gaming":
                st, det = ("Running" if d.get("holds") else "Idle"), ", ".join(d.get("holds", []))
            elif name == "media":
                playing = [k for k, v in d.items() if v == "Playing"]
                st, det = ("Playing" if playing else "Idle"), ", ".join(f"{k}: {v}" for k, v in d.items())
            elif name == "pin":
                st, det = ("Pinned" if d.get("profile") else "Idle"), d.get("profile") or ""
            elif name == "schedule":
                st, det = ("Window active" if d.get("active") else "Idle"), f"{d.get('windows', 0)} window(s)"
            elif name == "power":
                st, det = (d.get("mode") or "unknown"), ""
            else:
                st, det = "", json.dumps(d)
            if not enabled:
                st = "disabled"
            item = QTreeWidgetItem([label, st, det])
            item.setIcon(0, icon(*SOURCE_ICONS.get(name, ())))
            if not enabled:
                for c in range(3):
                    item.setForeground(c, self.palette().placeholderText())
            elif name == s.get("reason"):
                for c in range(3):
                    f = item.font(c)
                    f.setBold(True)
                    item.setFont(c, f)
            self.tree.addTopLevelItem(item)
        for c in (0, 1):
            self.tree.resizeColumnToContents(c)


