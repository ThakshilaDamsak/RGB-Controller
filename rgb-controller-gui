class ProfileCombo(QComboBox):
    """Editable combo of OpenRGB profile names; flags names that are not saved in OpenRGB."""
    changed = Signal()

    def __init__(self, ctx, allow_empty=False):
        super().__init__()
        self.ctx = ctx
        self.allow_empty = allow_empty
        self.setEditable(True)
        self.setMinimumWidth(180)
        self.setSizeAdjustPolicy(QComboBox.SizeAdjustPolicy.AdjustToContentsOnFirstShow)
        ctx.changed.connect(self._refill)
        self.editTextChanged.connect(lambda _t: (self._flag(), self.changed.emit()))
        self._refill()

    def _refill(self):
        text = self.currentText()
        self.blockSignals(True)
        self.clear()
        for name in self.ctx.profiles:
            self.addItem(profile_icon(name), name)
        self.setEditText(text)
        self.blockSignals(False)
        self._flag()

    def _flag(self):
        text = self.currentText()
        missing = bool(self.ctx.profiles) and bool(text) and text not in self.ctx.profiles
        self.setStyleSheet("QComboBox { border: 1px solid #d97706; }" if missing else "")
        self.setToolTip(f"'{text}' is not saved in OpenRGB yet (profiles found: {len(self.ctx.profiles)})" if missing else "")

    def value(self):
        return self.currentText().strip()

    def set_value(self, v):
        self.blockSignals(True)
        self.setEditText(v)
        self.blockSignals(False)
        self._flag()


class StringList(QWidget):
    changed = Signal()

    def __init__(self, placeholder=""):
        super().__init__()
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        self.list = QListWidget()
        self.list.setMaximumHeight(90)
        row = QHBoxLayout()
        self.edit = QLineEdit()
        self.edit.setPlaceholderText(placeholder)
        add, rem = QPushButton("Add"), QPushButton("Remove")
        row.addWidget(self.edit, 1)
        row.addWidget(add)
        row.addWidget(rem)
        lay.addWidget(self.list)
        lay.addLayout(row)
        add.clicked.connect(self._add)
        self.edit.returnPressed.connect(self._add)
        rem.clicked.connect(self._remove)

    def _add(self):
        t = self.edit.text().strip()
        if t and t not in self.get():
            self.list.addItem(t)
            self.edit.clear()
            self.changed.emit()

    def _remove(self):
        for it in self.list.selectedItems():
            self.list.takeItem(self.list.row(it))
        self.changed.emit()

    def get(self):
        return [self.list.item(i).text() for i in range(self.list.count())]

    def set(self, items):
        self.list.clear()
        self.list.addItems([str(i) for i in items])


