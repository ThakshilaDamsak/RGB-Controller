        self.advanced.sync_prefs(prefs)
        self.on_availability(daemon.alive)
        self.mark_dirty(False)

    # --- daemon connection ----------------------------------------------------------------
    def on_availability(self, alive):
        self.banner.setVisible(not alive)
        self.advanced.refresh_system()
        if alive:
            self.fetch_config()
            self.daemon.call("Status", cb=lambda ok, js: ok and self.on_state(json.loads(js)))
            self.daemon.call_json("History", lambda ok, lines: ok and self.logpage.set_history(lines))
        else:
            self.live.dot.setPixmap(profile_pixmap(None, 72))
            self.live.now.setText("Daemon offline")
            self.live.why.setText("")
            self.live.applied.setText("")
            self.live.applied_icon.clear()
            self.update_side(None)
            self.update_tray(None)

    def fetch_config(self):
        def got(ok, cfg):
            if not ok:
                return self.flash(f"Could not read the daemon config: {cfg}")
            self.values = cfg["values"]
            self.defaults = cfg["defaults"]
            self.config_path = cfg["path"]
            self.revert()
        self.daemon.call_json("Config", got)

    def on_state(self, s):
        self.state = s
        self.live.set_state(s)
        self.update_side(s)
        self.update_tray(s)
        if self.config_version is None:
            self.config_version = s.get("config")
        elif s.get("config") != self.config_version:  # edited by hand, or by a second GUI
            self.config_version = s.get("config")
            if not self.dirty:
                self.fetch_config()

    def update_side(self, s):
        if s:
            target = s.get("target") or "…"
            self.side_status.setIcon(profile_icon(target))
            self.side_status.setText(f" {target}")
        else:
            self.side_status.setIcon(profile_icon(None))
            self.side_status.setText(" Daemon offline")

    # --- editing ----------------------------------------------------------------------------
    def _page_changed(self, row):
        self.stack.setCurrentIndex(row)
        self.bar.setVisible(self.pages[row][1].editable)
        if self.pages[row][0] == "Advanced":
            self.advanced.refresh_system()

    def mark_dirty(self, dirty=True):
        self.dirty = bool(dirty)
        self.apply_btn.setEnabled(self.dirty)
        self.revert_btn.setEnabled(self.dirty)
        self.dirty_lab.setText("You have unsaved changes" if self.dirty else "")

    def collect(self):
        vals = copy.deepcopy(self.values)
        for _n, page, _i in self.pages:
            if page.editable:
                page.dump(vals)
        return vals

    def revert(self):
        v = dict(self.values)
        v["__defaults__"] = self.defaults
        v["__path__"] = self.config_path
        for _n, page, _i in self.pages:
            if page.editable:
                page.load(v)
        self.mark_dirty(False)

    def apply(self):
        vals = self.collect()
        overrides = {k: val for k, val in vals.items() if val != self.defaults.get(k)}
        self.save_overrides(overrides)

    def save_overrides(self, overrides):
        self.write_raw(dump_toml(overrides).encode())

    def write_raw(self, raw):
        path = self.config_path
        if not path:
            return self.flash("Daemon not connected, cannot find the config file")
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            if os.path.exists(path):
                with open(path, "rb") as f:
                    old = f.read()
                if CONFIG_HEADER.splitlines()[0].encode() not in old and old.strip():
                    with open(path + ".bak", "wb") as b:  # a hand-written file: keep a copy of it once
                        b.write(old)
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".config-", suffix=".toml")
            with os.fdopen(fd, "wb") as f:
                f.write(raw)
            os.replace(tmp, path)
        except OSError as e:
            return self.flash(f"Could not save: {e}")
        self.daemon.call("Reload", cb=lambda ok, p: (self.flash("Saved and applied" if ok else f"Saved, but the daemon is not answering: {p}"),
                                                     ok and self.fetch_config()))

    def flash(self, text):
        self.status.showMessage(text, 6000)

    def set_pref(self, key, value):
        self.prefs[key] = value
        save_prefs(self.prefs)
        if self.tray:
            self.update_tray(self.state)

    # --- tray ---------------------------------------------------------------------------------
    def attach_tray(self, tray):
        self.tray = tray
        self.menu = QMenu()
        tray.setContextMenu(self.menu)
        tray.activated.connect(lambda r: r in (QSystemTrayIcon.ActivationReason.Trigger,) and self.toggle())
        self.ctx.changed.connect(lambda: self.update_tray(self.state))
        self.update_tray(self.state)
        tray.show()

    def toggle(self):
        if self.isVisible() and not self.isMinimized():
            self.hide()
        else:
            self.bring_up()

    def bring_up(self):
        self.show()
        self.setWindowState(self.windowState() & ~Qt.WindowState.WindowMinimized)
        self.raise_()
        self.activateWindow()

    def update_tray(self, s):
        if not self.tray:
            return
        target = (s or {}).get("target")
        self.tray.setIcon(profile_icon(target if self.prefs["tray_color"] else "rainbow") if s else profile_icon(None))
        if s:
            why = REASONS.get(s.get("reason"), s.get("reason", ""))
            self.tray.setToolTip(f"RGB: {target}\nbecause {why}")
        else:
            self.tray.setToolTip("RGB Controller: daemon not running")
        m = self.menu
        m.clear()
        head = m.addAction(profile_icon(target), f"{target}" if s else "Daemon not running")
        head.setEnabled(False)
        m.addAction("Open RGB Controller", self.bring_up).setIcon(app_icon())
        m.addSeparator()
        if s:
            pin_menu = m.addMenu(icon("pin", "object-locked"), "Pin a profile")
            for name in self.ctx.profiles:
                sub = pin_menu.addMenu(profile_icon(name), name)
                for label, secs in PIN_DURATIONS[:1] + PIN_DURATIONS[2:5]:
                    sub.addAction(label, lambda n=name, sc=secs: self.daemon.call("Pin", n, sc))
            if "Off" in self.ctx.profiles:
                m.addAction("Lights off for 1 hour", lambda: self.daemon.call("Pin", "Off", 3600)).setIcon(profile_icon("Off"))
            pinned = bool(s["sources"].get("pin", {}).get("profile"))
            un = m.addAction("Unpin", lambda: self.daemon.call("Unpin"))
            un.setIcon(icon("window-unpin", "object-unlocked"))
            un.setEnabled(pinned)
            m.addSeparator()
        else:
            m.addAction("Start the daemon", lambda: self.advanced.systemctl("start")).setIcon(icon("media-playback-start"))
            m.addSeparator()
        m.addAction("Open OpenRGB", lambda: QProcess.startDetached("openrgb", [])).setIcon(icon("system-run"))
        m.addAction("Quit this window (daemon keeps running)", self.app.quit).setIcon(icon("application-exit"))

    # --- closing --------------------------------------------------------------------------------
    def closeEvent(self, ev):
        if self.tray and self.tray.isVisible() and self.prefs["close_to_tray"]:
            ev.ignore()
            self.hide()
            if not self.prefs["told_about_tray"]:
                self.prefs["told_about_tray"] = True
                save_prefs(self.prefs)
                self.tray.showMessage("RGB Controller", "Still running in the tray. The daemon keeps switching your lights "
                                      "even if you quit this window.", QSystemTrayIcon.MessageIcon.Information, 6000)
        else:
            ev.accept()
            self.app.quit()


def main(argv=None):
    argv = list(sys.argv if argv is None else argv)
    start_hidden = "--tray" in argv
    app = QApplication(argv)
    app.setApplicationName("RGB Controller")
    app.setDesktopFileName(APP_ID)
    app.setQuitOnLastWindowClosed(False)

    # single instance: a second launch just raises the first window
    sock_name = f"{APP_ID}-{os.getuid()}"
    probe = QLocalSocket()
    probe.connectToServer(sock_name)
    if probe.waitForConnected(300):
        probe.write(b"show")
        probe.flush()
        probe.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(sock_name)
    server = QLocalServer()
    server.listen(sock_name)

    prefs = load_prefs()
    daemon = DaemonClient()
    ctx = Ctx()
    win = Window(app, daemon, ctx, prefs)
    server.newConnection.connect(lambda: (server.nextPendingConnection().deleteLater(), win.bring_up()))
    tray_requested = "--tray" in argv
    if QSystemTrayIcon.isSystemTrayAvailable():
        win.attach_tray(QSystemTrayIcon())
    elif tray_requested:
        # At early login the tray may not be ready yet; keep hidden and attach once it is.
        def try_attach_tray():
            if win.tray is None and QSystemTrayIcon.isSystemTrayAvailable():
                win.attach_tray(QSystemTrayIcon())
                timer.stop()
        timer = QTimer()
        timer.timeout.connect(try_attach_tray)
        timer.start(1000)
    else:
        start_hidden = False
    if not start_hidden:
        win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
