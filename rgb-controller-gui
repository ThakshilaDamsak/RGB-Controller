        super().__init__(("preferences-system-notifications", "preferences-other"), "Triggers",
                         "What makes the lights react.")
        self.ctx = ctx

        self.body.addWidget(heading("Loading: what counts as a progress bar"))
        self.w_job = QCheckBox("KDE job views")
        self.w_launcher = QCheckBox("Taskbar progress")
        self.w_notif = QCheckBox("Notifications that carry a progress bar")
        self.w_proc = QCheckBox("Real pacman inside cachy-update")
        for c, desc in ((self.w_job, "Dolphin copies/moves, Discover, KIO downloads."),
                        (self.w_launcher, "Browser downloads and installers (com.canonical.Unity.LauncherEntry)."),
                        (self.w_notif, ""),
                        (self.w_proc, "Lights Loading only during the inner pacman step of cachy-update, not the whole run.")):
            c.toggled.connect(self.changed)
            self.body.addWidget(check_row(c, desc))
        self.body.addSpacing(4)
        self.body.addWidget(wrap_label("Ignore progress notifications from these apps:"))
        self.ign_notif = StringList("app name, e.g. Spotify")
        self.ign_notif.changed.connect(self.changed)
        self.body.addWidget(self.ign_notif)
        self.body.addWidget(hint("Terminal jobs (pacman, paru, cachyos-rate-mirrors...) come from the Fish wrapper, "
                                 "see the README. cachy-update opens a watch window and only its inner pacman "
                                 "lights Loading. Watching is switched off while you are on battery."))

        self.body.addWidget(heading("Media"))
        self.body.addWidget(wrap_label("A player counts as Spotify when its MPRIS name contains:"))
        self.hints = StringList("spotify")
        self.hints.changed.connect(self.changed)
        self.body.addWidget(self.hints)
        self.beats = QCheckBox("Spotify wins when it plays together with other media")
        self.beats.toggled.connect(self.changed)
        self.body.addWidget(self.beats)
        self.body.addSpacing(4)
        self.body.addWidget(wrap_label("Ignore these players (e.g. kdeconnect for music playing on your phone):"))
        self.ign_players = StringList("part of the player name")
        self.ign_players.changed.connect(self.changed)
        self.body.addWidget(self.ign_players)

        self.body.addWidget(heading("Per-player profiles", "First match wins and beats the Spotify rule."))
        self.rules = QTableWidget(0, 3)
        self.rules.setHorizontalHeaderLabels(["Player name contains", "Profile", ""])
        self.rules.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        self.rules.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        self.rules.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        self.rules.verticalHeader().hide()
        self.rules.setShowGrid(False)
        self.rules.setAlternatingRowColors(True)
        self.rules.setSelectionMode(QAbstractItemView.SelectionMode.NoSelection)
        self.rules.setMinimumHeight(150)
        self.body.addWidget(boxed(self.rules))
        add = push("Add rule", "list-add")
        add.clicked.connect(lambda: (self._rule_row("", ""), self.changed.emit()))
        self.body.addWidget(add, 0, Qt.AlignmentFlag.AlignLeft)
        self.body.addWidget(hint("Names are the part after org.mpris.MediaPlayer2. (see the Live page for what is running), "
                                 "for example vlc, mpv, firefox, chromium."))
        self.body.addStretch(1)

    def _rule_row(self, match, profile):
        r = self.rules.rowCount()
        self.rules.insertRow(r)
        le = QLineEdit(match)
        le.setClearButtonEnabled(True)
        le.textChanged.connect(self.changed)
        combo = ProfileCombo(self.ctx)
        combo.set_value(profile)
        combo.changed.connect(self.changed)
        rm = tool_button(("edit-delete", "list-remove"), "Remove rule")
        rm.clicked.connect(lambda _c=False, w=le: self._remove_rule(w))
        self.rules.setCellWidget(r, 0, le)
        self.rules.setCellWidget(r, 1, combo)
        self.rules.setCellWidget(r, 2, rm)
        self.rules.setRowHeight(r, 36)

    def _remove_rule(self, widget):
        for r in range(self.rules.rowCount()):
            if self.rules.cellWidget(r, 0) is widget:
                self.rules.removeRow(r)
                break
        self.changed.emit()

    def load(self, v):
        self.w_job.setChecked(v.get("watch_jobview", True))
        self.w_launcher.setChecked(v.get("watch_launcher", True))
        self.w_notif.setChecked(v.get("watch_notifications", True))
        self.w_proc.setChecked(v.get("watch_proc_pacman", True))
        self.ign_notif.set(v.get("ignore_notification_apps", []))
        self.hints.set(v.get("spotify_hints", []))
        self.beats.setChecked(v.get("spotify_beats_other_media", True))
        self.ign_players.set(v.get("ignore_players", []))
        self.rules.setRowCount(0)
        for r in v.get("media_rules", []):
            self._rule_row(r.get("match", ""), r.get("profile", ""))

    def dump(self, v):
        v["watch_jobview"] = self.w_job.isChecked()
        v["watch_launcher"] = self.w_launcher.isChecked()
        v["watch_notifications"] = self.w_notif.isChecked()
        v["watch_proc_pacman"] = self.w_proc.isChecked()
        v["ignore_notification_apps"] = self.ign_notif.get()
        v["spotify_hints"] = self.hints.get()
        v["spotify_beats_other_media"] = self.beats.isChecked()
        v["ignore_players"] = self.ign_players.get()
        rules = []
        for r in range(self.rules.rowCount()):
            m, p = self.rules.cellWidget(r, 0).text().strip(), self.rules.cellWidget(r, 1).value()
            if m and p:
                rules.append({"match": m, "profile": p})
        v["media_rules"] = rules


class ScheduleRow(Card):
    """One schedule window as a card."""
    removed = Signal(object)
    edited = Signal()
    DAYS = "MTWTFSS"
    NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

    def __init__(self, ctx, name, start, end, days, profile):
        super().__init__()
        lay = QVBoxLayout(self)
        lay.setContentsMargins(16, 12, 12, 14)
        lay.setSpacing(10)

        top = QHBoxLayout()
        top.setSpacing(10)
        self.name = QLineEdit(name)
        self.name.setPlaceholderText("Window name")
        self.name.setClearButtonEnabled(True)
        rm = tool_button(("edit-delete", "list-remove"), "Remove window")
        top.addWidget(self.name, 1)
        top.addWidget(rm)
        lay.addLayout(top)

        # profile, time range and days sit in a flow: one line when wide, wrapped when narrow
        prof = QWidget()
        pl = QHBoxLayout(prof)
        pl.setContentsMargins(0, 0, 0, 0)
        pl.setSpacing(8)
        self.profile = ProfileCombo(ctx)
        self.profile.set_value(profile)
        pl.addWidget(QLabel("Profile"))
        pl.addWidget(self.profile)

        times = QWidget()
        tl = QHBoxLayout(times)
        tl.setContentsMargins(0, 0, 0, 0)
        tl.setSpacing(8)
        tl.addWidget(icon_label(icon("view-calendar-time-spent", "chronometer", "clock"), 18))
        self.t1 = QTimeEdit(QTime.fromString(start, "HH:mm"))
        self.t2 = QTimeEdit(QTime.fromString(end, "HH:mm"))
        for t in (self.t1, self.t2):
            t.setDisplayFormat("HH:mm")
        tl.addWidget(self.t1)
        tl.addWidget(QLabel("→"))
        tl.addWidget(self.t2)

        daysw = QWidget()
        dl = QHBoxLayout(daysw)
        dl.setContentsMargins(0, 0, 0, 0)
        dl.setSpacing(4)
        self.day_buttons = []
        for i, ch in enumerate(self.DAYS):
            b = QToolButton()
            b.setText(ch)
            b.setCheckable(True)
            b.setChecked(i in days)
            b.setToolTip(self.NAMES[i])
            b.setFixedWidth(32)
            self.day_buttons.append(b)
            dl.addWidget(b)
            b.toggled.connect(self.edited)

        host = QWidget()
        fl = FlowLayout(host, spacing=16)
        fl.addWidget(prof)
        fl.addWidget(times)
        fl.addWidget(daysw)
        lay.addWidget(host)

        self.name.textChanged.connect(self.edited)
        self.profile.changed.connect(self.edited)
        self.t1.timeChanged.connect(self.edited)
        self.t2.timeChanged.connect(self.edited)
        rm.clicked.connect(lambda: self.removed.emit(self))

    def values(self):
        return {"name": self.name.text().strip(), "start": self.t1.time().toString("HH:mm"),
                "end": self.t2.time().toString("HH:mm"),
                "days": [i for i, b in enumerate(self.day_buttons) if b.isChecked()],
                "profile": self.profile.value()}


class SchedulePage(FormPage):
    def __init__(self, ctx, daemon):
        super().__init__(("view-calendar-time-spent", "view-calendar", "appointment-new"), "Schedule",
                         "Time windows with their own profile, e.g. lights off from 23:30 to 07:00. A window may cross "
                         "midnight; its days are the days it starts on. Needs the Schedule trigger ticked on the "
                         "Priority page, and it only wins over triggers ranked below it there.")
        self.ctx = ctx
        self.rows = []
        self.rows_box = QVBoxLayout()
        self.rows_box.setSpacing(10)
        self.body.addLayout(self.rows_box)
        self.empty = QWidget()
        el = QVBoxLayout(self.empty)
        el.setContentsMargins(0, 36, 0, 36)
        el.setSpacing(8)
        el.setAlignment(Qt.AlignmentFlag.AlignCenter)
        ic = QLabel()
        ic.setPixmap(icon("view-calendar-time-spent", "view-calendar", "appointment-new").pixmap(QSize(48, 48)))
        ic.setAlignment(Qt.AlignmentFlag.AlignCenter)
        el.addWidget(ic)
        t = QLabel("No schedule windows yet")
        scale_font(t, 1.3, bold=True)
        t.setAlignment(Qt.AlignmentFlag.AlignCenter)
        el.addWidget(t)
        sub = hint("Add a window to override your lights at specific times, e.g. dim them at night.")
        sub.setAlignment(Qt.AlignmentFlag.AlignCenter)
        el.addWidget(sub)
        self.empty.setVisible(True)
        self.body.addWidget(self.empty)
        row = QHBoxLayout()
        add = push("Add window", "list-add")
        add.clicked.connect(lambda: (self._row("", "22:00", "07:00", range(7), ""), self.changed.emit()))
        night = push("Add night mode (23:30 → 07:00, lights off)", "weather-clear-night", "night-light")
        night.clicked.connect(lambda: (self._row("Night", "23:30", "07:00", range(7), "Off"), self.changed.emit()))
        row.addWidget(add)
        row.addWidget(night)
        row.addStretch(1)
        self.body.addLayout(row)
        self.body.addStretch(1)

    def _row(self, name, start, end, days, profile):
        r = ScheduleRow(self.ctx, name, start, end, days, profile)
        r.edited.connect(self.changed)
        r.removed.connect(self._remove)
        self.rows.append(r)
        self.rows_box.addWidget(r)
        self.empty.setVisible(False)

    def _remove(self, row):
        if row in self.rows:
            self.rows.remove(row)
            row.setParent(None)
            row.deleteLater()
        self.empty.setVisible(not self.rows)
        self.changed.emit()

    def load(self, v):
        for r in self.rows:
            r.setParent(None)
            r.deleteLater()
        self.rows = []
        for w in v.get("schedule", []):
            self._row(w.get("name", ""), w.get("start", "00:00"), w.get("end", "00:00"), w.get("days", range(7)), w.get("profile", ""))
        self.empty.setVisible(not self.rows)

    def dump(self, v):
        out = []
        for r in self.rows:
            d = r.values()
            if d["profile"] and d["days"]:
                out.append(d)
        v["schedule"] = out


class TimingPage(FormPage):
    SPINS = [
        ("debounce_ms", "Debounce", "ms", 0, 5000, 50, "Bursts of events (a track change, a window of D-Bus chatter) become one decision."),
        ("loading_grace_ms", "Loading grace", "ms", 0, 30000, 100, "Progress shorter than this never shows Loading (no flicker for tiny copies)."),
        ("loading_linger_ms", "Loading linger", "ms", 0, 30000, 100, "Keep Loading this long after the last job ends, so back-to-back jobs do not flap."),
        ("proc_scan_ms", "Pacman scan", "ms", 100, 5000, 100, "How often to check for the real pacman inside cachy-update while a watch window is open."),
        ("resume_settle_ms", "Resume settle", "ms", 0, 30000, 100, "After suspend, wait this long before touching USB devices again."),
        ("progress_stale_s", "Stale progress", "s", 10, 86400, 30, "Forget a progress bar nobody has updated for this long (crashed app)."),
        ("openrgb_timeout_s", "OpenRGB timeout", "s", 3, 300, 1, "Kill an openrgb call that takes longer than this."),
        ("media_off_delay_s", "Media OFF delay", "s", 0, 300, 1, "Wait this long after non-Spotify media starts before turning lights off (0 = instant). Prevents flicker when scrolling past videos."),
    ]

    def __init__(self, ctx, daemon):
        super().__init__(("chronometer", "preferences-system-time", "appointment-soon"), "Timing",
                         "Nothing here polls: these are one-shot timers that only exist while something is pending.")
        rows = {}  # key -> (title, description, control)
        self.spins = {}
        for key, label, unit, lo, hi, step, desc in self.SPINS:
            sp = QSpinBox()
            sp.setRange(lo, hi)
            sp.setSingleStep(step)
            sp.setSuffix(" " + unit)
            sp.valueChanged.connect(self.changed)
            self.spins[key] = sp
            rows[key] = (label, desc, sp)
        self.hold = QDoubleSpinBox()
        self.hold.setRange(0, 168)
        self.hold.setDecimals(2)
        self.hold.setSingleStep(0.5)
        self.hold.setSuffix(" h")
        self.hold.valueChanged.connect(self.changed)
        rows["hold"] = ("Game hold limit", "Safety net: a game-rgb start that never gets its stop (Lutris crashed) "
                        "expires after this. 0 = never.", self.hold)
        self.retry = QLineEdit()
        self.retry.setPlaceholderText("2, 5, 15")
        self.retry.setClearButtonEnabled(True)
        self.retry.textChanged.connect(self.changed)
        rows["retry"] = ("Retry delays (s)", "If openrgb fails (USB not ready), retry after these many seconds, "
                         "then give up until the next change.", self.retry)

        groups = [
            ("Reaction speed", "How quickly the lights follow what you are doing.",
             ["debounce_ms", "loading_grace_ms", "loading_linger_ms", "proc_scan_ms", "media_off_delay_s"]),
            ("Hardware", "How patiently the daemon talks to your devices.",
             ["resume_settle_ms", "openrgb_timeout_s", "retry"]),
            ("Safety nets", "Clean-up for things that never finished.",
             ["progress_stale_s", "hold"]),
        ]
        for name, sub, keys in groups:
            self.body.addWidget(heading(name, sub))
            group = SettingsGroup()
            for k in keys:
                title_, desc, widget = rows[k]
                group.add_row(title_, desc, widget)
            self.body.addWidget(group)
        self.body.addStretch(1)

    def load(self, v):
        for k, sp in self.spins.items():
            sp.blockSignals(True)
            if k == "media_off_delay_s":
                # Daemon stores ms, GUI uses seconds
                sp.setValue(int(v.get("media_off_delay_ms", 0)) // 1000)
            else:
                sp.setValue(int(v.get(k, 0)))
            sp.blockSignals(False)
        self.hold.blockSignals(True)
        self.hold.setValue(float(v.get("hold_max_hours", 12)))
        self.hold.blockSignals(False)
        self.retry.blockSignals(True)
        self.retry.setText(", ".join(str(x) for x in v.get("retry_delays_s", [])))
        self.retry.blockSignals(False)

    def dump(self, v):
        for k, sp in self.spins.items():
            if k == "media_off_delay_s":
                # GUI stores seconds, daemon expects ms
                v["media_off_delay_ms"] = sp.value() * 1000
            else:
                v[k] = sp.value()
        v["hold_max_hours"] = self.hold.value()
        delays = []
        for part in self.retry.text().replace(";", ",").split(","):
            part = part.strip()
            if part.isdigit() and int(part) > 0:
                delays.append(int(part))
        v["retry_delays_s"] = delays


class AdvancedPage(FormPage):
    def __init__(self, ctx, daemon, window):
        super().__init__(("configure", "preferences-other", "applications-development"), "Advanced",
                         "Daemon control, window behaviour and the config file.")
        self.daemon, self.window_ = daemon, window
        self.config_path = ""

        self.cmd = QLineEdit()
        self.cmd.setClearButtonEnabled(True)
        self.cmd.textChanged.connect(self.changed)
        plain = push("Plain openrgb")
        plain.clicked.connect(lambda: self.cmd.setText("openrgb"))
        srv = push("Use a running OpenRGB server (faster)", "network-server")
        srv.setToolTip("openrgb --client localhost:6742  (start the server with: openrgb --server)")
        srv.clicked.connect(lambda: self.cmd.setText("openrgb --client localhost:6742"))
        test = push("Test", "dialog-ok-apply", "system-run")
        test.clicked.connect(self._test)
        self.body.addWidget(card_section(
            "How profiles are applied", "", self.cmd, button_flow(plain, srv, test),
            hint("The profile name is added as: <command> --profile NAME. A full device scan per switch can take a "
                 "second or two; with a server running it is instant.")))

        srow = QHBoxLayout()
        srow.setSpacing(8)
        self.dstate_icon = QLabel()
        self.dstate_icon.setFixedSize(16, 16)
        self.dstate = QLabel("…")
        srow.addWidget(self.dstate_icon)
        srow.addWidget(self.dstate, 1)
        btns = []
        for text, act, ic in (("Start", "start", ("media-playback-start",)), ("Stop", "stop", ("media-playback-stop",)),
                              ("Restart", "restart", ("view-refresh",))):
            b = push(text, *ic)
            b.clicked.connect(lambda _c=False, a=act: self.systemctl(a))
            btns.append(b)
        self.d_enabled = QCheckBox("Start the daemon at login")
        self.d_enabled.clicked.connect(lambda on: self.systemctl("enable" if on else "disable"))
        self.body.addWidget(card_section(
            "Daemon", "", srow, button_flow(*btns), self.d_enabled,
            hint("Closing this window never stops the daemon. Stopping it here leaves your lights as they are.")))

        self.close_tray = QCheckBox("Closing the window keeps it in the tray")
        self.tray_color = QCheckBox("Tray icon takes the colour of the current profile")
        self.autostart = QCheckBox("Start in the tray at login")
        for c, key in ((self.close_tray, "close_to_tray"), (self.tray_color, "tray_color")):
            c.clicked.connect(lambda on, k=key: window.set_pref(k, on))
        self.autostart.clicked.connect(self._autostart)
        self.body.addWidget(card_section("This window", "", self.close_tray, self.tray_color, self.autostart))

        self.path_lab = QLabel("")
        self.path_lab.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self.path_lab.setWordWrap(True)
        fbtns = []
        for text, ic, fn in (("Open file", ("document-open",), self._open_file),
                             ("Open folder", ("folder-open",), self._open_dir),
                             ("Export…", ("document-export", "document-save-as"), self._export),
                             ("Import…", ("document-import", "document-open"), self._import),
                             ("Reset everything to defaults", ("edit-reset", "edit-undo"), self._reset)):
            b = push(text, *ic)
            b.clicked.connect(fn)
            fbtns.append(b)
        self.body.addWidget(card_section(
            "Config file", "", self.path_lab, button_flow(*fbtns),
            hint("The file only lists what differs from the built-in defaults, and the daemon applies edits the "
                 "moment the file is saved, whether they come from here or from your editor.")))
        self.body.addStretch(1)
        self.refresh_system()

    # --- values --------------------------------------------------------------------
    def load(self, v):
        self.config_path = v.get("__path__", "")
        self.path_lab.setText(self.config_path)
        self.cmd.blockSignals(True)
        self.cmd.setText(shlex.join(v.get("openrgb_cmd", ["openrgb"])))
        self.cmd.blockSignals(False)

    def dump(self, v):
        try:
            parts = shlex.split(self.cmd.text())
        except ValueError:
            parts = []
        v["openrgb_cmd"] = parts or ["openrgb"]

    # --- helpers -------------------------------------------------------------------
    def _test(self):
        try:
            argv = shlex.split(self.cmd.text()) or ["openrgb"]
        except ValueError as e:
            return self.window_.flash(f"Cannot parse the command: {e}")
        run_async(self, argv[0], [*argv[1:], "--version"], lambda ok, out: self.window_.flash(
            (f"OK: {out.splitlines()[0]}" if out else "OK") if ok else f"Failed: {out[:200]}"))

    def systemctl(self, action):
        def done(ok, out):
            if not ok and action in ("start", "restart"):
                QProcess.startDetached("rgb-controller", [])  # not installed as a service: run it directly
                self.window_.flash("systemd unit not found, started the daemon directly")
            elif not ok:
                self.window_.flash(f"systemctl {action}: {out[:200]}")
            self.refresh_system()
        run_async(self, "systemctl", ["--user", action, UNIT], done)

    def refresh_system(self):
        run_async(self, "systemctl", ["--user", "is-enabled", UNIT], lambda ok, out: self.d_enabled.setChecked(out == "enabled"))
        alive = self.daemon.alive
        self.dstate.setText("Running" if alive else "Not running")
        self.dstate_icon.setPixmap((icon("dialog-ok-apply", "emblem-ok-symbolic") if alive
                                    else icon("dialog-warning")).pixmap(QSize(16, 16)))

    def _autostart_path(self):
        return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "autostart", "rgb-controller-gui.desktop")

    def _autostart(self, on):
        path = self._autostart_path()
        stale = os.path.join(os.path.dirname(path), "rgb-controller-gui-autostart.desktop")
        try:
            if os.path.exists(stale):
                os.remove(stale)
            if on:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w") as f:
                    f.write("[Desktop Entry]\nType=Application\nName=RGB Controller\nExec=rgb-controller-gui --tray\n"
                            "Icon=rgb-controller\nTerminal=false\nCategories=Settings;HardwareSettings;\n"
                            "X-GNOME-Autostart-enabled=true\nStartupNotify=false\nX-KDE-StartupNotify=false\n")
            elif os.path.exists(path):
                os.remove(path)
        except OSError as e:
            self.window_.flash(f"Autostart: {e}")

    def sync_prefs(self, prefs):
        self.close_tray.setChecked(prefs["close_to_tray"])
        self.tray_color.setChecked(prefs["tray_color"])
        self.autostart.setChecked(os.path.exists(self._autostart_path()))

    def _open_file(self):
        if self.config_path:
            if not os.path.exists(self.config_path):
                self.window_.save_overrides({})
            QDesktopServices.openUrl(QUrl.fromLocalFile(self.config_path))

    def _open_dir(self):
        if self.config_path:
            QDesktopServices.openUrl(QUrl.fromLocalFile(os.path.dirname(self.config_path)))

    def _export(self):
        dest, _ = QFileDialog.getSaveFileName(self, "Export config", "rgb-controller-config.toml", "TOML (*.toml)")
        if dest and self.config_path and os.path.exists(self.config_path):
            with open(self.config_path, "rb") as src, open(dest, "wb") as out:
                out.write(src.read())
            self.window_.flash(f"Exported to {dest}")

    def _import(self):
        src, _ = QFileDialog.getOpenFileName(self, "Import config", "", "TOML (*.toml)")
        if src and self.config_path:
            with open(src, "rb") as f:
                self.window_.write_raw(f.read())

    def _reset(self):
        if QMessageBox.question(self, "Reset", "Forget all your settings and go back to the built-in defaults?") == QMessageBox.StandardButton.Yes:
            self.window_.save_overrides({})


class LogPage(Page):
    editable = False

    def __init__(self, daemon):
        super().__init__()
        lay = QVBoxLayout(self)
        lay.setContentsMargins(28, 24, 28, 20)
        lay.setSpacing(10)
        lay.addWidget(PageHeader(("text-x-log", "view-list-text", "utilities-log-viewer"), "Log",
                                 "What the daemon has been doing."))
        row = QHBoxLayout()
        self.filter = QLineEdit()
        self.filter.setPlaceholderText("Filter…")
        self.filter.setClearButtonEnabled(True)
        self.filter.addAction(icon("edit-find"), QLineEdit.ActionPosition.LeadingPosition)
        self.filter.textChanged.connect(self._refilter)
        clear = push("Clear", "edit-clear-all", "edit-clear")
        clear.clicked.connect(self._clear)
        copy_b = push("Copy", "edit-copy")
        copy_b.clicked.connect(lambda: QApplication.clipboard().setText(self.view.toPlainText()))
        row.addWidget(self.filter, 1)
        row.addWidget(clear)
        row.addWidget(copy_b)
        lay.addLayout(row)
        self.view = QPlainTextEdit()
        self.view.setReadOnly(True)
        self.view.setMaximumBlockCount(2000)
        self.view.setFont(QFontDatabase.systemFont(QFontDatabase.SystemFont.FixedFont))
        lay.addWidget(boxed(self.view), 1)
        self.count = dim(QLabel(""))
        lay.addWidget(self.count)
        self.lines = []
        daemon.logline.connect(self.add)

    def _matches(self, line):
        return self.filter.text().lower() in line.lower()

    def add(self, line):
        self.lines.append(line)
        self.lines = self.lines[-2000:]
        if self._matches(line):
            self.view.appendPlainText(line)
        self._count()

    def set_history(self, lines):
        self.lines = list(lines)
        self._refilter()

    def _refilter(self):
        self.view.setPlainText("\n".join(l for l in self.lines if self._matches(l)))
        self.view.verticalScrollBar().setValue(self.view.verticalScrollBar().maximum())
        self._count()

    def _count(self):
        shown = sum(1 for l in self.lines if self._matches(l))
        self.count.setText(f"{shown} of {len(self.lines)} lines")

    def _clear(self):
        self.lines = []
        self.view.clear()
        self._count()


