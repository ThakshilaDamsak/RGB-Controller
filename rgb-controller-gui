class FlowLayout(QLayout):
    """Left to right, wraps when the row is full."""

    def __init__(self, parent=None, spacing=6):
        super().__init__(parent)
        self._items = []
        self._sp = spacing
        self.setContentsMargins(0, 0, 0, 0)

    def addItem(self, item):
        self._items.append(item)

    def count(self):
        return len(self._items)

    def itemAt(self, i):
        return self._items[i] if 0 <= i < len(self._items) else None

    def takeAt(self, i):
        return self._items.pop(i) if 0 <= i < len(self._items) else None

    def clear(self):
        while self._items:
            w = self._items.pop().widget()
            if w:
                w.setParent(None)
                w.deleteLater()
        self.invalidate()

    def expandingDirections(self):
        return Qt.Orientation(0)

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, w):
        return self._do(QRect(0, 0, w, 0), True)

    def setGeometry(self, rect):
        super().setGeometry(rect)
        self._do(rect, False)

    def sizeHint(self):
        return self.minimumSize()

    def minimumSize(self):
        s = QSize()
        for it in self._items:
            s = s.expandedTo(it.minimumSize())
        m = self.contentsMargins()
        return s + QSize(m.left() + m.right(), m.top() + m.bottom())

    def _do(self, rect, test):
        m = self.contentsMargins()
        r = rect.adjusted(m.left(), m.top(), -m.right(), -m.bottom())
        x, y, line_h = r.x(), r.y(), 0
        for it in self._items:
            sz = it.sizeHint()
            nx = x + sz.width()
            if nx > r.right() + 1 and line_h > 0:
                x = r.x()
                y += line_h + self._sp
                nx = x + sz.width()
                line_h = 0
            if not test:
                it.setGeometry(QRect(QPoint(x, y), sz))
            x = nx + self._sp
            line_h = max(line_h, sz.height())
        return y + line_h - rect.y() + m.top() + m.bottom()


class TileGrid(QLayout):
    """Equal-width tiles that always fill the row. Rows are balanced, so 8 tiles become 4+4 (or 3+3+2 when
    narrow), never 7+1 with a lonely orphan."""

    def __init__(self, parent=None, min_w=104, spacing=8):
        super().__init__(parent)
        self._items = []
        self._min_w, self._sp = min_w, spacing
        self.setContentsMargins(0, 0, 0, 0)

    def addItem(self, item):
        self._items.append(item)

    def count(self):
        return len(self._items)

    def itemAt(self, i):
        return self._items[i] if 0 <= i < len(self._items) else None

    def takeAt(self, i):
        return self._items.pop(i) if 0 <= i < len(self._items) else None

    def clear(self):
        while self._items:
            w = self._items.pop().widget()
            if w:
                w.setParent(None)
                w.deleteLater()
        self.invalidate()

    def expandingDirections(self):
        return Qt.Orientation.Horizontal

    def hasHeightForWidth(self):
        return True

    def _cols(self, width):
        n = len(self._items)
        if not n:
            return 1
        max_cols = max(1, (width + self._sp) // (self._min_w + self._sp))
        rows = math.ceil(n / max_cols)
        return math.ceil(n / rows)

    def _tile_h(self):
        return max((it.sizeHint().height() for it in self._items), default=0)

    def heightForWidth(self, w):
        m = self.contentsMargins()
        n = len(self._items)
        if not n:
            return m.top() + m.bottom()
        cols = self._cols(w - m.left() - m.right())
        rows = math.ceil(n / cols)
        return rows * self._tile_h() + (rows - 1) * self._sp + m.top() + m.bottom()

    def setGeometry(self, rect):
        super().setGeometry(rect)
        m = self.contentsMargins()
        r = rect.adjusted(m.left(), m.top(), -m.right(), -m.bottom())
        if not self._items:
            return
        cols = self._cols(r.width())
        tw = (r.width() - (cols - 1) * self._sp) / cols
        th = self._tile_h()
        for i, it in enumerate(self._items):
            row, col = divmod(i, cols)
            x = r.x() + round(col * (tw + self._sp))
            it.setGeometry(QRect(x, r.y() + row * (th + self._sp), round(tw), th))

    def sizeHint(self):
        m = self.contentsMargins()
        return QSize(self._min_w + m.left() + m.right(), self._tile_h() + m.top() + m.bottom())

    def minimumSize(self):
        return self.sizeHint()


class Card(QFrame):
    """Rounded panel painted with the theme's view colours."""

    def __init__(self):
        super().__init__()
        self.setFrameShape(QFrame.Shape.NoFrame)

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pal = self.palette()
        edge = QColor(pal.color(QPalette.ColorRole.WindowText))
        edge.setAlpha(40)
        p.setBrush(pal.base())
        p.setPen(QPen(edge, 1))
        p.drawRoundedRect(QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5), 6, 6)
        super().paintEvent(ev)


def boxed(widget, margin=2):
    """Put a list / tree / table / text view inside a bordered Card so every view shares one outline."""
    if isinstance(widget, QFrame):
        widget.setFrameShape(QFrame.Shape.NoFrame)
    card = Card()
    lay = QVBoxLayout(card)
    lay.setContentsMargins(margin, margin, margin, margin)
    lay.setSpacing(0)
    lay.addWidget(widget)
    return card


def card_section(title, sub, *items):
    """Heading plus one bordered Card holding widgets / layouts, with consistent padding."""
    box = QWidget()
    v = QVBoxLayout(box)
    v.setContentsMargins(0, 0, 0, 0)
    v.setSpacing(8)
    v.addWidget(heading(title, sub))
    card = Card()
    cl = QVBoxLayout(card)
    cl.setContentsMargins(16, 14, 16, 14)
    cl.setSpacing(10)
    for it in items:
        cl.addLayout(it) if isinstance(it, QLayout) else cl.addWidget(it)
    v.addWidget(card)
    return box


class InlineMessage(QFrame):
    """Inline banner in the spirit of KMessageWidget, tinted from the palette."""

    def __init__(self, icon_names, text, kind="info"):
        super().__init__()
        self.kind = kind
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.lay = QHBoxLayout(self)
        self.lay.setContentsMargins(12, 8, 8, 8)
        self.lay.setSpacing(10)
        self.lay.addWidget(icon_label(icon(*icon_names), 22))
        self.label = QLabel(text)
        self.label.setWordWrap(True)
        self.lay.addWidget(self.label, 1)

    def add_action(self, text, icon_names, slot):
        b = push(text, *icon_names)
        b.clicked.connect(slot)
        self.lay.addWidget(b)

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        role = QPalette.ColorRole.BrightText if self.kind == "error" else QPalette.ColorRole.Highlight
        base = QColor(self.palette().color(role))
        fill = QColor(base)
        fill.setAlpha(38)
        p.setBrush(fill)
        p.setPen(QPen(base, 1))
        p.drawRoundedRect(QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5), 6, 6)
        super().paintEvent(ev)


class Chip(QWidget):
    """Pill used by the priority chain: win = filled, wants = dashed, idle = faint."""

    def __init__(self, text, kind):
        super().__init__()
        self.text, self.kind = text, kind
        f = self.font()
        f.setBold(kind == "win")
        self.setFont(f)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)

    def sizeHint(self):
        fm = self.fontMetrics()
        return QSize(fm.horizontalAdvance(self.text) + 28, fm.height() + 12)

    def minimumSizeHint(self):
        return self.sizeHint()

    def paintEvent(self, _ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pal = self.palette()
        r = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        if self.kind == "win":
            p.setBrush(pal.highlight())
            p.setPen(Qt.PenStyle.NoPen)
            txt = pal.color(QPalette.ColorRole.HighlightedText)
        elif self.kind == "wants":
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(pal.color(QPalette.ColorRole.Highlight), 1, Qt.PenStyle.DashLine))
            txt = pal.color(QPalette.ColorRole.WindowText)
        else:
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(pal.color(QPalette.ColorRole.Mid), 1))
